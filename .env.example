# Required for live AI agents. Without it the platform runs in demo mode with sample outputs.
ANTHROPIC_API_KEY=
# Optional: override the model used by the agents (default claude-opus-5-5)
PULSERX_MODEL=claude-opus-5-5
# Where the SQLite database lives (mount a volume here in production)
DATABASE_PATH=./data/marketingrx.db
# One-time secret (16+ characters) to make your account an admin: sign up, open /admin/claim, enter it.
# Remove it from the environment once you're in.
ADMIN_SETUP_TOKEN=
# Public URL of the app (used for Stripe redirects)
APP_URL=http://localhost:3000
# Optional: Google PageSpeed Insights API key for Core Web Vitals in Site Doctor
GOOGLE_PSI_KEY=
# Optional: Stripe billing
# Stripe secret key is all that's needed for payments; prices come from src/lib/markets.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed Stripe prices (override the price list), e.g. STRIPE_PRICE_PRO_AUD=price_...
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ---------- Connected accounts (Google Ads, Search Console, YouTube, Meta, TikTok) ----------
# See "Connecting Google, Meta and TikTok" in README.md. Leave a provider's vars empty and it shows as
# "not switched on yet" in Settings > Connected accounts; owners can still upload exports.
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored tokens. Required for any connection.
# Don't change it once owners have connected: stored tokens can't be read with a new key (they'd need to reconnect).
ENCRYPTION_KEY=
# APP_URL above must be the exact public URL: redirect URIs are ${APP_URL}/api/connect/google/callback and /meta/callback.
# Google OAuth client (Google Cloud > APIs & Services > Credentials > OAuth client ID, type Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Ads API developer token (Google Ads manager account > Admin > API Center). Leave empty and Google
# connects for Search Console only.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional. Normally empty: we work out the manager account per ad account automatically.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional. Google Ads API version (default v22). Google retires versions about a year after release.
GOOGLE_ADS_API_VERSION=
# Meta app (developers.facebook.com > your app > App settings > Basic)
META_APP_ID=
META_APP_SECRET=
# Optional. Graph API version (default v23.0).
META_GRAPH_VERSION=
# Optional. Facebook Login for Business configuration ID (asks for ads_read). Without it we send scope=ads_read.
META_LOGIN_CONFIG_ID=
# Optional. Set to 1 to also ask for business_management and list ad accounts owned by the person's businesses.
META_BUSINESS_ACCOUNTS=
# Optional. Set to 0 to stop asking for the Page and Instagram permissions (organic posts for the video library).
META_ORGANIC=
# Optional. Set to 0 to leave YouTube out of the Google connection.
GOOGLE_YOUTUBE=
# Set to 1 once Google has approved Business Profile API access for the project (Pro's Business Profile specialist).
GOOGLE_BUSINESS_PROFILE=
# TikTok Login Kit app (developers.tiktok.com), scopes user.info.basic and video.list.
# Redirect URI: ${APP_URL}/api/connect/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# ElevenLabs speech to text for the latest videos (Growth 20, Pro 100). Leave empty and nothing is transcribed.
ELEVENLABS_API_KEY=
# Optional. Speech to text model (default scribe_v2).
ELEVENLABS_STT_MODEL=
# Internal only: older workspaces that saved a key for the previous ad-sync supplier (Windsor.ai) keep syncing
# through their own saved key while this is set (any non-empty value, e.g. your Windsor key) and they haven't
# connected Google or Meta natively. Remove it to switch the fallback off.
WINDSOR_API_KEY=

# ---------- Help chat and WhatsApp support (all optional) ----------
# The PULSE team's WhatsApp number, digits only with country code (e.g. 6591234567). Pro accounts get a
# "WhatsApp the PULSE team" button on Help. Leave it empty and Pro uses the Help chat like every plan.
# SUPPORT_WHATSAPP=
# Alert the team on WhatsApp when an owner writes in the Help chat (WhatsApp Cloud API). Leave any of the
# next three empty and no alert is sent. At most one alert per thread every 10 minutes.
# Access token for the WhatsApp Business account (Meta Business settings > System users).
# WHATSAPP_TOKEN=
# The sending number's ID from WhatsApp Manager > API setup (not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# Who gets the alert: comma-separated numbers, digits only with country code.
# SUPPORT_NOTIFY_NUMBERS=6591234567,6598765432
# Alerts start the conversation, so WhatsApp requires an approved message template. Create it in
# WhatsApp Manager > Message templates with two body variables: {{1}} the business name, {{2}} the message.
# WHATSAPP_TEMPLATE=new_support_message
# The template's language code as approved in WhatsApp Manager.
# WHATSAPP_TEMPLATE_LANG=en

# ---------- Flood protection (all optional; defaults shown) ----------
# Requests per address per minute before a 429.
# RATE_LIMIT_PAGES_PER_MIN=240
# RATE_LIMIT_API_PER_MIN=300
# Free website checkups across all visitors.
# CHECKUP_MAX_CONCURRENT=6
# CHECKUP_MAX_PER_MINUTE=40
# Specialist runs at once across all businesses, and live AI runs an hour from free accounts.
# RUNS_MAX_CONCURRENT=24
# FREE_RUNS_PER_HOUR=120
# New accounts per address per hour.
# SIGNUPS_PER_IP_PER_HOUR=5
# Behind Cloudflare: the secret Cloudflare adds as the x-origin-key header (see README).
# CLOUDFLARE_ORIGIN_KEY=
